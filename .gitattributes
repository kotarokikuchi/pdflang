# The last matching line wins, so the general rule goes first and the
# exceptions after it. Written the other way round, `* text=auto` overrode
# `*.pdf binary` and the fixtures were still being converted.
* text=auto

# A PDF is bytes, and its cross-reference table records byte offsets. Checked
# out on Windows, where git's autocrlf is on by default, every LF inside these
# files becomes CRLF: the offsets stop matching and the file no longer parses —
# "invalid file trailer", from a fixture that is fine in the repository. Marking
# them binary is what keeps a checkout byte-for-byte identical everywhere.
*.pdf binary

# Scripts run by a shell need LF, whatever the checkout does with the rest.
*.sh text eol=lf
