// dados.pdfl — data:: namespace demonstration
// Usage: pdfl run examples/dados.pdfl document.pdf
// (run from the project root: the paths are relative)

profile "validation-with-references" {

  check "Required Terms" tags: ["glossary"] {
    missing = data::validate_against_reference("examples/glossario.txt")
    assert missing.length == 0,
    "glossary terms missing from the document: #{missing.join(", ")}"
  }

  check "Approved Batch" tags: ["data"] {
    // cross-checks the barcode in the PDF against the local batch table
    code = codes::decode_barcode(1)
    description = data::lookup_value("examples/lotes.csv", code)
    assert description, "code #{code} is not in the batch table"
    print("Batch found:", description)
  }
}
