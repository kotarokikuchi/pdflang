// proof.pdfl — print shop: the press file against the approved proof
// Usage: pdfl run examples/proof.pdfl press-ready.pdf
// 
// The client signed off on a proof. Days later a "final" file arrives, and the
// question is whether anything moved since the signature — a swapped photo, a
// price corrected without telling anyone, an image degraded by a round trip
// through the wrong export preset.
// 
// Point APPROVED at the file that was signed off.

profile "press-file-vs-approved-proof" {

  const APPROVED = "approved/proof-signed.pdf"

  // Below this, the page is not the page that was approved.
  const IDENTICAL = 0.995

  // Reprinting costs money; a page that only *nearly* matches is worth a look
  // before it goes on press, not after.
  const SUSPICIOUS = 0.999

  check "Page count" tags: ["proof"] {
    // Compared page by page below, so a mismatch here would make every
    // later comparison meaningless.
    assert doc.page_count == 8,
    "the approved proof has 8 pages, this file has #{doc.page_count}"
  }

  check "Nothing moved since sign-off" tags: ["proof"] {
    doc.pages.each { |page|
      ssim = visual::measure_ssim(page.number, APPROVED)
      assert ssim >= IDENTICAL,
      "page #{page.number} differs from the approved proof (SSIM #{ssim})"
    }
  }

  check "Close but not identical" tags: ["proof"] severity: warning {
    // Sub-pixel differences are normal between exports. A page that lands
    // between the two thresholds is usually a re-rendered font or a nudged
    // element — worth a human look, not worth stopping the press.
    doc.pages.each { |page|
      ssim = visual::measure_ssim(page.number, APPROVED)
      assert ssim >= SUSPICIOUS || ssim < IDENTICAL,
      "page #{page.number} is nearly identical but not exactly (SSIM #{ssim}) — check it"
    }
  }

  check "No image swapped" tags: ["proof"] {
    // Perceptual hash catches a replaced photo that SSIM might average away
    // on a busy page.
    doc.pages.each { |page|
      assert !visual::detect_image_replacement(page.number, APPROVED),
      "page #{page.number}: an image looks replaced since the proof"
    }
  }

  check "Not damaged by re-export" tags: ["quality"] {
    // A file that went through a JPEG round trip arrives with block edges the
    // proof never had.
    doc.pages.each { |page|
      assert !visual::detect_image_artifacts(page.number),
      "page #{page.number}: compression artifacts — re-export from the source"
    }
  }

  check "Gradients still smooth" tags: ["quality"] severity: warning {
    // Banding survives to paper and is expensive to discover there.
    doc.pages.each { |page|
      assert !visual::detect_banding(page.number),
      "page #{page.number}: banding in a gradient"
    }
  }
}
